#!/usr/bin/env bash
# Check a release the way someone installing it would use it: unzip it into a temporary directory,
# start it on an empty database, create the first account, sign in, load the consoles and the
# participant pages, back up the database, then restart it on the same database and sign in again.
# The restart has a proxy set for the internet (http_proxy, as many researchers have) and a
# conf/local.conf, whose setting must be in effect and which only its owner may read once the
# launcher has started. It also checks what the launcher says to a second copy (from the same
# folder, and on the same port), about folders it can't write to and a conf/local.conf it can't
# read, and that a read-only folder runs with -Dpidfile.path. A release that carries its own Java
# (bin/bundle-java) is started on that Java. On macOS, the computer must be kept awake while the
# server runs.
#
#   JAVA8_HOME=/path/to/jdk8 bin/smoke-dist [target/release/breadboard-<version>.zip] [--db old/breadboard.h2.db]
#
# --db starts the release on a copy of an older release's database instead (an upgrade). When that
# database has accounts already, it can't sign in (it doesn't know their passwords) and only checks
# that the server starts and serves its pages.
# PORT (default 19000) is the port it uses.
set -Eeuo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
ZIP=""
OLD_DB=""
while [ $# -gt 0 ]; do
  case "$1" in
    --db) OLD_DB="$2"; shift 2 ;;
    *) ZIP="$1"; shift ;;
  esac
done
if [ -z "$ZIP" ]; then
  ZIP="$(ls -t "$ROOT"/target/release/breadboard-*.zip 2>/dev/null | head -1 || true)"
fi
if [ -z "$ZIP" ] || [ ! -f "$ZIP" ]; then
  echo "bin/smoke-dist: no release zip; build one with bin/make-dist." >&2
  exit 1
fi
ZIP="$(cd "$(dirname "$ZIP")" && pwd)/$(basename "$ZIP")"
PORT="${PORT:-19000}"
BASE="http://localhost:$PORT"
# Its own requests go to this computer: no proxy. (The launcher is given one where that is checked.)
unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY no_proxy NO_PROXY
# The proxy the launcher starts with (start, below): none, or one that lets nothing through.
PROXY=""

WORK="$(mktemp -d)"
SERVER=""
cleanup () {
  if [ -n "$SERVER" ] && kill -0 "$SERVER" 2>/dev/null; then
    kill "$SERVER" 2>/dev/null || true
    wait "$SERVER" 2>/dev/null || true
  fi
  # (a check below makes folders read-only)
  chmod -R u+w "$WORK" 2>/dev/null || true
  rm -rf "$WORK"
}
trap cleanup EXIT
# Anything else that fails (set -e) says where, instead of stopping without a word.
trap 'fail "unexpected failure at line $LINENO"' ERR

fail () {
  echo "FAIL: $*" >&2
  if [ -f "$WORK/server.log" ]; then
    echo "---- server output ----" >&2
    tail -60 "$WORK/server.log" >&2
  fi
  exit 1
}
pass () { echo "ok   $*"; }

unzip -q "$ZIP" -d "$WORK"
APP="$(find "$WORK" -mindepth 1 -maxdepth 1 -type d -name 'breadboard-*' | head -1)"
[ -x "$APP/breadboard.sh" ] || fail "the zip has no breadboard.sh"
[ -f "$APP/conf/application-prod.conf" ] || fail "the zip has no conf/application-prod.conf"
[ -f "$APP/groovy/step.groovy" ] || fail "the zip has no groovy/ engine scripts"
if ls "$APP"/groovy/*_test.groovy >/dev/null 2>&1; then fail "the zip carries test scripts"; fi
[ -s "$APP/lib/classpath.txt" ] || fail "the zip has no lib/classpath.txt"
[ "$(wc -l < "$APP/lib/classpath.txt")" -eq "$(find "$APP/lib" -name '*.jar' | wc -l)" ] \
  || fail "lib/classpath.txt doesn't list every jar in lib/"
[ -f "$APP/docs/install.md" ] || fail "the zip has no docs/"
[ -f "$APP/conf/logger.xml" ] || fail "the zip has no conf/logger.xml"
[ ! -e "$APP/conf/local.conf" ] || fail "the zip has a conf/local.conf (the researcher's own settings)"
if [ -f "$APP/breadboard.bat" ]; then
  grep -q "$(printf '\r')$" "$APP/breadboard.bat" || fail "breadboard.bat doesn't have Windows line endings"
  # Task Scheduler's task, as Windows saves one: UTF-16 with a byte order mark
  [ -f "$APP/breadboard-task.xml" ] || fail "the zip has breadboard.bat but no breadboard-task.xml"
  [ "$(head -c 2 "$APP/breadboard-task.xml" | od -An -tx1 | tr -d ' \n')" = fffe ] \
    || fail "breadboard-task.xml isn't UTF-16 with a byte order mark"
  python3 -c 'import sys, xml.dom.minidom; xml.dom.minidom.parse(sys.argv[1])' "$APP/breadboard-task.xml" \
    || fail "breadboard-task.xml isn't well-formed XML"
fi
case "$(basename "$ZIP")" in
  *-linux-*) ;;
  *) [ -x "$APP/Start Breadboard.command" ] || fail "the zip has no Start Breadboard.command" ;;
esac
if [ -d "$APP/jre" ]; then
  [ -x "$APP/jre/bin/java" ] || fail "the zip's jre/ has no bin/java"
  # Zulu's licence and notices go with it (LICENSE.md says they are there)
  for notice in LICENSE ASSEMBLY_EXCEPTION THIRD_PARTY_README DISCLAIMER readme.txt; do
    [ -f "$APP/jre/$notice" ] || fail "the zip's jre/ has no $notice"
  done
  # the launcher must find it by itself
  unset JAVA8_HOME JAVA_HOME
fi
pass "release layout"
if [ -n "$OLD_DB" ]; then
  cp "$OLD_DB" "$APP/db/breadboard.h2.db"
fi

# In the launcher's subshell: PROXY, if set, as the proxy for the internet
use_proxy () {
  if [ -n "$PROXY" ]; then
    export http_proxy="$PROXY" all_proxy="$PROXY"
  fi
}

# The caffeinate that keeps this Mac awake for the process $1, if one does
awake_for () {
  pgrep -f "^caffeinate -i -s -w $1\$" 2>/dev/null || true
}

# start "what this start is" [more settings for the server]
# (on the port given as -Dhttp.port, or, with PORT_IN_LOCAL_CONF set, on the one conf/local.conf gives)
PORT_IN_LOCAL_CONF=""
start () {
  local what="$1" from port_arg="-Dhttp.port=$PORT"
  shift
  [ -z "$PORT_IN_LOCAL_CONF" ] || port_arg=""
  touch "$WORK/server.log"
  from=$(( $(wc -l < "$WORK/server.log") + 1 ))
  (cd "$APP" && use_proxy && exec ./breadboard.sh ${port_arg:+"$port_arg"} "$@") >> "$WORK/server.log" 2>&1 &
  SERVER=$!
  for _ in $(seq 1 180); do
    if ! kill -0 "$SERVER" 2>/dev/null; then fail "the server stopped while starting"; fi
    if [ "$(curl -s --max-time 30 -o /dev/null -w '%{http_code}' "$BASE/" || true)" = "200" ]; then
      pass "server started ($what)"
      tail -n +"$from" "$WORK/server.log" | grep -qF "On this computer: http://localhost:$PORT" \
        || fail "the launcher didn't say where the server is reached"
      if [ -d "$APP/jre" ]; then
        ps -ww -o args= -p "$SERVER" 2>/dev/null | grep -qF "$APP/jre/bin/java" \
          || fail "the server doesn't run on the Java in jre/"
        pass "it runs on the Java that comes with it"
      fi
      # The secret goes to the server in its environment, never on its command line.
      if [ -s "$APP/conf/application.secret" ] \
        && ps -ww -o args= -p "$SERVER" 2>/dev/null | grep -qF "$(cat "$APP/conf/application.secret")"; then
        fail "application.secret is visible on the server's command line"
      fi
      if [ "$(uname)" = Darwin ]; then
        [ -n "$(awake_for "$SERVER")" ] || fail "nothing keeps this Mac awake while the server runs (caffeinate)"
      fi
      return
    fi
    sleep 1
  done
  fail "the server did not answer within 180 s"
}

stop () {
  local was="$SERVER"
  kill "$SERVER"
  wait "$SERVER" 2>/dev/null || true
  SERVER=""
  [ ! -f "$APP/RUNNING_PID" ] || rm -f "$APP/RUNNING_PID"
  if [ "$(uname)" = Darwin ]; then
    sleep 1
    [ -z "$(awake_for "$was")" ] || fail "the Mac is still kept awake after the server stopped"
  fi
}

# GET a path; fail unless the status is $2 (default 200). The body goes to $WORK/body.
get () {
  local code
  code="$(curl -s --max-time 30 -o "$WORK/body" -w '%{http_code}' -b "$WORK/cookies" -c "$WORK/cookies" "$BASE$1")"
  [ "$code" = "${2:-200}" ] || fail "GET $1 answered $code, expected ${2:-200}"
}

pages () {
  get /health
  grep -q '"status":"ok"' "$WORK/body" || fail "/health doesn't say ok: $(cat "$WORK/body")"
  grep -q '"diskFreeMb":[0-9]' "$WORK/body" || fail "/health doesn't say how much disk space is free: $(cat "$WORK/body")"
  get /
  grep -q 'admin/admin.js' "$WORK/body" || fail "the console page doesn't load admin.js"
  get /legacy-admin
  for asset in admin/admin.js admin/admin.css bundles/client.js bundles/design.js bundles/breadboard.js css/participant.css; do
    get "/assets/$asset"
  done
  # Compressed for browsers that accept it (admin.js itself is a few bytes: its code is in chunks)
  for asset in admin/admin.css bundles/client.js; do
    curl -s --max-time 30 -o /dev/null -D "$WORK/headers" -H 'Accept-Encoding: gzip, deflate, br' "$BASE/assets/$asset"
    grep -qi '^content-encoding: *gzip' "$WORK/headers" || fail "/assets/$asset isn't sent gzipped"
  done
  # The startup bundle of the console, and the participant page, stay small.
  local client
  client="$(curl -s --max-time 30 "$BASE/assets/bundles/client.js" | wc -c | tr -d ' ')"
  [ "$client" -lt 2000000 ] || fail "client.js is $client bytes"
  pass "consoles, participant bundles and stylesheets"
  get /game/999/999/someone/connected
  grep -q "link isn" "$WORK/body" || fail "a link to a session that doesn't exist isn't reported as invalid"
  pass "participant page of a session that doesn't exist"
}

json () { python3 -c "import json,sys; d=json.load(open(sys.argv[1])); print($1)" "$WORK/body"; }

sign_in () {
  rm -f "$WORK/cookies"
  local code
  code="$(curl -s --max-time 30 -o "$WORK/body" -w '%{http_code}' -c "$WORK/cookies" \
    --data-urlencode "email=$EMAIL" --data-urlencode "password=$PASSWORD" "$BASE/login")"
  [ "$code" = "200" ] || fail "signing in answered $code"
  get /state
  [ "$(json "d.get('email')")" = "$EMAIL" ] || fail "/state doesn't name the signed-in account"
  get /autopilot
  get /researchers
  [ "$(json "[r['email'] for r in d['researchers'] if r['you']][0]")" = "$EMAIL" ] || fail "/researchers doesn't list the account"
  pass "signed in; account state, autopilot settings and accounts load"
}

backups () {
  local code name
  code="$(curl -s --max-time 60 -o "$WORK/body" -w '%{http_code}' -b "$WORK/cookies" -X POST "$BASE/backups")"
  [ "$code" = "200" ] || fail "backing up answered $code: $(cat "$WORK/body")"
  name="$(json "[b['name'] for b in d['backups'] if b['name'].endswith('-manual.zip')][0]")"
  [ -f "$APP/backups/$name" ] || fail "the backup $name isn't in backups/"
  get "/backups/$name"
  unzip -l "$WORK/body" | grep -q 'breadboard.h2.db' || fail "the downloaded backup doesn't hold breadboard.h2.db"
  pass "a backup made in the console downloads as a zip of the database"
}

if [ -n "$OLD_DB" ]; then start "an older release's database"; else start "empty database"; fi
[ -s "$APP/conf/application.secret" ] || fail "no conf/application.secret was generated"
if [ -n "$OLD_DB" ]; then
  ls "$APP"/backups/breadboard-*-upgrade.zip >/dev/null 2>&1 || fail "no backup was made before upgrading the older database"
  pass "the older database was backed up before it was brought up to date"
fi
pages

get /autopilot 401
get /languages
LANG_ID="$(json "[l['id'] for l in d['languages'] if l['code'] == 'eng'][0]")"
EMAIL="smoke@breadboard.test"
PASSWORD="smoke-$(head -c 12 /dev/urandom | od -An -tx1 | tr -d ' \n')"
code="$(curl -s --max-time 30 -o "$WORK/body" -w '%{http_code}' -H 'Content-Type: application/json' \
  -d "{\"email\":\"$EMAIL\",\"password\":\"$PASSWORD\",\"defaultLanguageId\":$LANG_ID}" "$BASE/createFirstUser")"
SIGN_IN=1
if [ "$code" = "200" ]; then
  pass "first account created"
  sign_in
  backups
elif [ -n "$OLD_DB" ] && grep -q "already exists" "$WORK/body"; then
  SIGN_IN=""
  pass "the older database has accounts: pages load, sign-in still required"
else
  fail "creating the first account answered $code: $(cat "$WORK/body")"
fi
# A second copy started from the same folder, on another port, is turned away with the first's address.
# (Its input, like that of the launchers below, is no terminal: with one, the launcher keeps running.)
if (cd "$APP" && exec ./breadboard.sh -Dhttp.port="$((PORT + 1))") > "$WORK/second.log" 2>&1 < /dev/null; then
  fail "a second copy started from the same folder"
fi
grep -q "already running from this folder" "$WORK/second.log" && grep -qF "http://localhost:$PORT," "$WORK/second.log" \
  || fail "a second copy from the same folder didn't say where the first one is: $(cat "$WORK/second.log")"
pass "a second copy from the same folder says where the first one is"
stop

# Again, with a conf/local.conf, whose settings win over conf/application-prod.conf's, and with a
# proxy set for the internet, as many researchers have (here one that isn't there, on port 9): the
# launcher's requests to this computer must not go through it. Its port and memory are the ones
# conf/local.conf gives, which the launcher passes on to Java (no -Dhttp.port is given here).
# (Curly quotes, as TextEdit's Smart Quotes types them, are fine in a comment and inside straight
# quotes; elsewhere they are named, below.)
LQ="$(printf '\342\200\234')"
RQ="$(printf '\342\200\235')"
printf '%s\n' "# the settings this install ${LQ}changes${RQ}" 'breadboard.wsUrl="ws://local-conf.smoke.test"' \
  "http.port = $PORT   # the lab's port" 'breadboard.memory: "768m"' "smoke.note=\"the ${LQ}lab${RQ} copy\"" \
  > "$APP/conf/local.conf"
# (readable by anyone, as a copy brought from an earlier release may be)
chmod 644 "$APP/conf/local.conf"
PROXY=http://127.0.0.1:9
PORT_IN_LOCAL_CONF=1
start "same database again, with conf/local.conf and a proxy set"
PORT_IN_LOCAL_CONF=""
ps -ww -o args= -p "$SERVER" 2>/dev/null | grep -qE -- "-Xmx768m .* -Dhttp\.port=$PORT launcher\.Main " \
  || fail "the port and memory in conf/local.conf weren't passed on to Java: $(ps -ww -o args= -p "$SERVER" | tr ' ' '\n' | grep -E '^-(Xmx|Dhttp)')"
pass "the port and memory set in conf/local.conf are the ones the server runs with"
# It may hold keys: the launcher lets only its owner read it.
case "$(ls -l "$APP/conf/local.conf")" in
  -rw-------*) pass "the launcher lets only its owner read conf/local.conf" ;;
  *) fail "others can read conf/local.conf: $(ls -l "$APP/conf/local.conf")" ;;
esac
pages
if [ -n "$SIGN_IN" ]; then
  sign_in
  get /state
  [ "$(json "d.get('connectSocket')")" = "ws://local-conf.smoke.test" ] || fail "conf/local.conf's setting isn't in effect"
  pass "conf/local.conf's settings are in effect"
fi
# Another Breadboard started on the same port (with a pid file of its own, as another copy has) is
# told that this one runs there. Through the proxy, the port would have seemed free.
if (cd "$APP" && use_proxy && exec ./breadboard.sh -Dhttp.port="$PORT" -Dpidfile.path="$WORK/other.pid") \
    > "$WORK/same-port.log" 2>&1 < /dev/null; then
  fail "another Breadboard started on the port this one uses"
fi
grep -qF "Breadboard is already running on port $PORT" "$WORK/same-port.log" \
  || fail "another Breadboard on the same port, with a proxy set, wasn't told this one runs there: $(cat "$WORK/same-port.log")"
pass "another Breadboard on the same port, with a proxy set, is told this one runs there"
PROXY=""
stop
rm -f "$APP/conf/local.conf"

# Curly quotes in conf/local.conf, outside straight quotes and comments, are named before Java starts.
printf '%s\n' '# the settings this install changes' "breadboard.rootUrl=${LQ}https://curly.smoke.test${RQ}" > "$APP/conf/local.conf"
if (cd "$APP" && exec ./breadboard.sh -Dhttp.port="$PORT") > "$WORK/curly.log" 2>&1 < /dev/null; then
  fail "it started with curly quotes in conf/local.conf"
fi
rm -f "$APP/conf/local.conf"
grep -q "Line 2 of conf/local.conf has curly quotes" "$WORK/curly.log" && ! grep -q "Play server process ID" "$WORK/curly.log" \
  || fail "curly quotes in conf/local.conf weren't named before Java started: $(cat "$WORK/curly.log")"
pass "curly quotes in conf/local.conf are named before Java starts"

# A db/ that can't be written is reported, with how to fix it, before Java starts. (Not as root,
# who can write anything.)
if [ "$(id -u)" != 0 ]; then
  chmod a-w "$APP/db"
  if (cd "$APP" && exec ./breadboard.sh -Dhttp.port="$PORT") > "$WORK/read-only.log" 2>&1 < /dev/null; then
    chmod u+w "$APP/db"
    fail "it started with a db/ it can't write to"
  fi
  chmod u+w "$APP/db"
  grep -q "db/ can't be written by" "$WORK/read-only.log" || fail "a db/ it can't write to wasn't reported: $(cat "$WORK/read-only.log")"
  # (this account's own: chmod fixes it, without an administrator)
  grep -q 'chmod -R u+rwX ".*/db"' "$WORK/read-only.log" && ! grep -q sudo "$WORK/read-only.log" \
    || fail "a db/ of this account's that it can't write to wasn't given chmod as the fix: $(cat "$WORK/read-only.log")"
  pass "a db/ that can't be written is reported, with how to fix it"

  # So is a conf/local.conf it can't read (made or copied by another account): Java would take it for
  # missing, and the server would run without its settings.
  printf '%s\n' 'breadboard.wsUrl="ws://local-conf.smoke.test"' > "$APP/conf/local.conf"
  chmod a-r "$APP/conf/local.conf"
  if (cd "$APP" && exec ./breadboard.sh -Dhttp.port="$PORT") > "$WORK/unreadable.log" 2>&1 < /dev/null; then
    fail "it started with a conf/local.conf it can't read"
  fi
  rm -f "$APP/conf/local.conf"
  grep -q "conf/local.conf can't be read by" "$WORK/unreadable.log" \
    || fail "a conf/local.conf it can't read wasn't reported: $(cat "$WORK/unreadable.log")"
  grep -q 'chmod u+rw ".*/conf/local.conf"' "$WORK/unreadable.log" && ! grep -q sudo "$WORK/unreadable.log" \
    || fail "a conf/local.conf of this account's that it can't read wasn't given chmod as the fix: $(cat "$WORK/unreadable.log")"
  pass "a conf/local.conf that can't be read is reported, with how to fix it"

  # A folder kept read-only (root's, under /opt) runs with a db/ and logs/ it can write and its pid
  # file elsewhere; without -Dpidfile.path, RUNNING_PID would go into it, and that is reported.
  # (cleanup makes it writable again if a check fails)
  chmod a-w "$APP"
  if (cd "$APP" && exec ./breadboard.sh -Dhttp.port="$PORT") > "$WORK/read-only-folder.log" 2>&1 < /dev/null; then
    fail "it started in a read-only folder, with nowhere to write RUNNING_PID"
  fi
  grep -q "The Breadboard folder (.*) can't be written by" "$WORK/read-only-folder.log" \
    || fail "a read-only folder wasn't reported: $(cat "$WORK/read-only-folder.log")"
  start "read-only folder, -Dpidfile.path elsewhere" -Dpidfile.path="$WORK/breadboard.pid"
  [ -s "$WORK/breadboard.pid" ] || fail "the server didn't write its process id where -Dpidfile.path says"
  get /health
  stop
  chmod u+w "$APP"
  pass "a read-only folder runs with -Dpidfile.path elsewhere, and is reported without it"
fi

# Play colours the level in its console output; logs/application.log has none.
ESC="$(printf '\033')"
if { sed "s/${ESC}\[[0-9;]*m//g" "$WORK/server.log"; cat "$APP"/logs/*.log 2>/dev/null || true; } \
    | grep -nE '^\[error\]|\[ERROR\]|Exception' > "$WORK/errors"; then
  head -20 "$WORK/errors" >&2
  fail "the server logged errors"
fi
pass "no errors in the server's output"
# Logback says so when it can't use a part of conf/logger.xml (|-ERROR in ..., |-WARN in ...).
if grep -E '\|-(ERROR|WARN) in ' "$WORK/server.log" > "$WORK/errors"; then
  head -20 "$WORK/errors" >&2
  fail "conf/logger.xml has a problem"
fi
# Debug output would log researchers' session tokens.
if grep -q '\[DEBUG\]' "$APP"/logs/*.log 2>/dev/null; then
  fail "the server logged debug output (conf/logger.xml is not in effect)"
fi
pass "no debug output in the logs, and conf/logger.xml loads without a problem"
# H2's own log (TRACE_LEVEL_FILE=0 in conf/application-prod.conf)
[ ! -e "$APP/db/breadboard.trace.db" ] || fail "H2 wrote db/breadboard.trace.db: $(head -5 "$APP/db/breadboard.trace.db")"

# (After the look for errors above: what follows makes the server fail on purpose.)
# A server that can't start (here a mistake in conf/local.conf) isn't started again, even with keep
# running on: the launcher says so and ends, and logs/start-errors.log keeps what Java printed as
# errors.
printf '%s\n' 'breadboard.rootUrl="https://unclosed.smoke.test' > "$APP/conf/local.conf"
(cd "$APP" && BREADBOARD_KEEP_RUNNING=1 exec ./breadboard.sh -Dhttp.port="$PORT") > "$WORK/start-failure.log" 2>&1 < /dev/null &
LAUNCHER=$!
for _ in $(seq 1 120); do
  kill -0 "$LAUNCHER" 2>/dev/null || break
  sleep 1
done
if kill -0 "$LAUNCHER" 2>/dev/null; then
  kill "$LAUNCHER" 2>/dev/null || true
  wait "$LAUNCHER" 2>/dev/null || true
  fail "the launcher kept trying to start a server that can't start: $(cat "$WORK/start-failure.log")"
fi
if wait "$LAUNCHER"; then
  fail "a launcher whose server couldn't start ended as if all went well"
fi
rm -f "$APP/conf/local.conf"
grep -q "so it is not started again" "$WORK/start-failure.log" && ! grep -q "Starting Breadboard again" "$WORK/start-failure.log" \
  || fail "a server that couldn't start was started again, or the launcher didn't say it isn't: $(cat "$WORK/start-failure.log")"
grep -q "conf/local.conf: 1" "$APP/logs/start-errors.log" 2>/dev/null \
  || fail "logs/start-errors.log doesn't say why the server couldn't start: $(cat "$APP/logs/start-errors.log" 2>&1)"
pass "a server that can't start isn't started again, and logs/start-errors.log says why"
echo "The release in $(basename "$ZIP") works."
