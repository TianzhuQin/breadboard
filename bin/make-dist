#!/usr/bin/env bash
# Build a release: target/release/breadboard-<version>.zip, which runs on any machine with Java 8.
#
#   JAVA8_HOME=/path/to/jdk8 bin/make-dist
#
# It builds the front end (pnpm), packages the server (sbt dist), and adds the launchers
# (release/breadboard.sh, release/breadboard.bat), the Groovy engine scripts, the production
# settings and the docs. SKIP_FRONTEND=1 reuses the front end already in public/.
# Check the result with bin/smoke-dist.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
VERSION="$(sed -n 's/.*appVersion *= *"\(.*\)".*/\1/p' project/Build.scala)"
if [ -z "$VERSION" ]; then
  echo "bin/make-dist: no appVersion in project/Build.scala." >&2
  exit 1
fi
NAME="breadboard-$VERSION"
# Not dist/: Play copies whatever is in dist/ into the package it builds.
OUT="$ROOT/target/release"

pnpm_cmd () {
  if command -v pnpm >/dev/null 2>&1; then
    pnpm "$@"
  else
    # The version frontend/package.json asks for (packageManager).
    npx -y "$(sed -n 's/.*"packageManager": *"\(pnpm@[^"]*\)".*/\1/p' "$ROOT/frontend/package.json")" "$@"
  fi
}

if [ -z "${SKIP_FRONTEND:-}" ]; then
  echo "== Front end"
  (cd frontend && pnpm_cmd install --frozen-lockfile && pnpm_cmd run build:all)
fi
for built in public/admin/admin.js public/bundles/client.js public/bundles/design.js; do
  if [ ! -s "$built" ]; then
    echo "bin/make-dist: $built is missing; build the front end first." >&2
    exit 1
  fi
done

echo "== Server"
"$ROOT/bin/sbt8" dist

echo "== $NAME"
rm -rf "${OUT:?}/$NAME" "$OUT/$NAME.zip"
mkdir -p "$OUT"
unzip -q "target/universal/$NAME.zip" -d "$OUT"
R="$OUT/$NAME"

# The launchers run Java themselves, with the jars in the order Play's own script lists them (a few
# classes are in two jars): keep that order in lib/classpath.txt, one jar per line.
CLASSPATH_LINE="$(sed -n 's/^declare -r app_classpath="\(.*\)"$/\1/p' "$R/bin/breadboard")"
if [ -z "$CLASSPATH_LINE" ]; then
  echo "bin/make-dist: no classpath in the bin/breadboard that sbt dist made." >&2
  exit 1
fi
printf '%s\n' "$CLASSPATH_LINE" | tr ':' '\n' | sed 's#^\$lib_dir/##' > "$R/lib/classpath.txt"
while read -r jar; do
  [ -f "$R/lib/$jar" ] || { echo "bin/make-dist: lib/$jar is listed but missing." >&2; exit 1; }
done < "$R/lib/classpath.txt"

# The jar carries the evolutions, the defaults and the routes; only the settings a release reads stay.
rm -rf "$R/conf" "$R/share" "$R/bin"
mkdir -p "$R/conf" "$R/db" "$R/logs" "$R/groovy"
cp conf/application-prod.conf "$R/conf/"
# The engine's Groovy scripts are read from <install>/groovy (tests excluded).
find groovy -maxdepth 1 -name '*.groovy' ! -name '*_test.groovy' -exec cp {} "$R/groovy/" \;
cp release/breadboard.sh "$R/"
chmod +x "$R/breadboard.sh"
# Windows line endings for cmd.exe, whatever the checkout has.
perl -pe 's/\r?\n/\r\n/' release/breadboard.bat > "$R/breadboard.bat"
cp release/README.md "$R/README.md"
cp LICENSE.md CHANGELOG.md "$R/"
# CHANGELOG.md and the README link to these.
mkdir -p "$R/docs"
cp docs/*.md "$R/docs/"

(cd "$OUT" && zip -qrX "$NAME.zip" "$NAME")
echo
echo "Built $OUT/$NAME.zip ($(du -h "$OUT/$NAME.zip" | cut -f1))"
if command -v shasum >/dev/null 2>&1; then
  (cd "$OUT" && shasum -a 256 "$NAME.zip" | tee "$NAME.zip.sha256")
fi
