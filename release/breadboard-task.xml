<?xml version="1.0" encoding="UTF-8"?>
<!--
  Windows: starts Breadboard whenever the computer starts, whether or not anyone signs in, and keeps
  it running (docs/install.md, "Running it for good", says more).
  1. Open this file in Notepad. Below, replace C:\path\to\your\Breadboard\folder with the folder
     that has breadboard.bat in it, and save.
  2. Open Command Prompt as administrator, go to that folder (cd /d "the folder"), and run:
       schtasks /Create /TN Breadboard /XML breadboard-task.xml /RU "%USERDOMAIN%\%USERNAME%" /RP
     Type your Windows password when it asks: the task runs as you.
  3. Start it now with  schtasks /Run /TN Breadboard  (or restart the computer).
-->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Breadboard: runs breadboard.bat when the computer starts, and starts it again if it stops by itself.</Description>
  </RegistrationInfo>
  <Triggers>
    <BootTrigger>
      <Enabled>true</Enabled>
    </BootTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>Password</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>5</Priority>
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>999</Count>
    </RestartOnFailure>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>cmd.exe</Command>
      <Arguments>/c "set BREADBOARD_SERVICE=1&amp;&amp; set BREADBOARD_NO_BROWSER=1&amp;&amp; breadboard.bat"</Arguments>
      <WorkingDirectory>C:\path\to\your\Breadboard\folder</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
