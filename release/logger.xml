<!--
  Logging for a release (the start scripts pass -Dlogger.file=conf/logger.xml).
  logs/application.log starts afresh every day; the last 30 days are kept as
  logs/application.YYYY-MM-DD.log. To see more detail while looking into a problem, set
  "application" to DEBUG and restart; put it back to INFO afterwards, as debug output is verbose
  and includes what participants and researchers send.
-->
<configuration>

  <conversionRule conversionWord="coloredLevel" converterClass="play.api.Logger$ColoredLevel" />

  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${application.home}/logs/application.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>${application.home}/logs/application.%d{yyyy-MM-dd}.log</fileNamePattern>
      <maxHistory>30</maxHistory>
    </rollingPolicy>
    <encoder>
      <pattern>%date - [%level] - from %logger in %thread %n%message%n%xException%n</pattern>
    </encoder>
  </appender>

  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%coloredLevel %logger{15} - %message%n%xException{5}</pattern>
    </encoder>
  </appender>

  <!-- The console's lines wait in a queue, and a thread of their own writes them out: a window that
       stops taking output (a click in a Windows console starts selecting text, which pauses it;
       Ctrl+S in a terminal) used to hold up everything that logs, participants signing in among
       them. Once 128 lines wait, which happens only when the console takes none, INFO lines are left
       out of the console (warnings and errors have the other 384 places); logs/application.log
       (FILE) still gets every line. -->
  <appender name="CONSOLE" class="ch.qos.logback.classic.AsyncAppender">
    <queueSize>512</queueSize>
    <discardingThreshold>384</discardingThreshold>
    <appender-ref ref="STDOUT" />
  </appender>

  <logger name="play" level="INFO" />
  <logger name="application" level="INFO" />
  <!-- Akka's own warnings and errors (akka.loggers in conf/application-prod.conf), e.g. the fatal
       error that stops the server -->
  <logger name="akka" level="WARN" />

  <!-- Noise from libraries that configure themselves (the connection pool warns about settings
       H2 doesn't need) -->
  <logger name="com.jolbox.bonecp" level="ERROR" />
  <logger name="com.avaje.ebean.config.PropertyMapLoader" level="OFF" />
  <logger name="com.avaje.ebeaninternal.server.core.XmlConfigLoader" level="OFF" />
  <logger name="com.avaje.ebeaninternal.server.lib.BackgroundThread" level="OFF" />

  <root level="WARN">
    <appender-ref ref="CONSOLE" />
    <appender-ref ref="FILE" />
  </root>

</configuration>
